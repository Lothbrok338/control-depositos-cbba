                                    "deposito_id": "@int(items('Para_cada_fila')?['id_txt'])",
                                    "resultado": "@outputs('Revalidacion')?['codigo']",
                                    "mensaje": "@if(equals(outputs('Revalidacion')?['codigo'],'NO_DISPONIBLE'),concat('El depósito ya no está DISPONIBLE (estado actual: ',outputs('Revalidacion')?['estado'],'). No se aplicó ningún cambio.'),if(equals(outputs('Revalidacion')?['codigo'],'CONFLICTO_DATOS'),concat('El depósito cambió desde la prevalidación (',outputs('Revalidacion')?['campo'],'). No se aplicó ningún cambio.'),'SharePoint no devolvió el ETag del depósito; no se aplicó ningún cambio.'))",
                                    "estado_final": "@outputs('Revalidacion')?['estado']",
                                    "banco": "@items('Para_cada_fila')?['banco']",
                                    "cuenta_bancaria": "@items('Para_cada_fila')?['cuenta']",
                                    "codigo_asignacion": "@items('Para_cada_fila')?['codigo']",
                                    "importe": "@div(float(items('Para_cada_fila')?['centavos']),100.0)",
                                    "moneda": "@items('Para_cada_fila')?['moneda']"
                                  }
                                },
                                "runAfter": {}
                              }
                            }
                          },
                          "runAfter": {
                            "Revalidacion": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "runAfter": {}
                    },
                    "CATCH_FILA": {
                      "type": "Scope",
                      "actions": {
                        "Agregar_error_fila": {
                          "type": "AppendToArrayVariable",
                          "inputs": {
                            "name": "varResultados",
                            "value": {
                              "fila_excel": "@items('Para_cada_fila')?['fila_excel']",
                              "deposito_id": "@int(items('Para_cada_fila')?['id_txt'])",
                              "resultado": "@if(and(equals(actions('Actualizar_deposito')?['status'],'Failed'),equals(outputs('Actualizar_deposito')?['statusCode'],412)),'CONFLICTO',if(equals(actions('Actualizar_deposito')?['status'],'Failed'),'ERROR_FILA',if(and(equals(actions('Leer_deposito')?['status'],'Failed'),equals(outputs('Leer_deposito')?['statusCode'],404)),'NO_ENCONTRADO','ERROR_FILA')))",
                              "mensaje": "@if(and(equals(actions('Actualizar_deposito')?['status'],'Failed'),equals(outputs('Actualizar_deposito')?['statusCode'],412)),'Otro usuario modificó el depósito mientras se confirmaba. No se aplicó tu confirmación.',if(equals(actions('Actualizar_deposito')?['status'],'Failed'),concat('No se pudo confirmar el depósito (HTTP ',string(outputs('Actualizar_deposito')?['statusCode']),'). Verifique su estado con PREVALIDAR antes de reintentar.'),if(and(equals(actions('Leer_deposito')?['status'],'Failed'),equals(outputs('Leer_deposito')?['statusCode'],404)),'El depósito ya no existe en SharePoint. No se aplicó ningún cambio.',if(equals(actions('Leer_deposito')?['status'],'Failed'),concat('No se pudo leer el depósito (HTTP ',string(outputs('Leer_deposito')?['statusCode']),'). No se aplicó ningún cambio.'),'Error inesperado al procesar la fila. Verifique el depósito con PREVALIDAR antes de reintentar.'))))",
                              "estado_final": "@if(and(equals(actions('Actualizar_deposito')?['status'],'Failed'),not(equals(outputs('Actualizar_deposito')?['statusCode'],412))),'DESCONOCIDO','')",
                              "banco": "@items('Para_cada_fila')?['banco']",
                              "cuenta_bancaria": "@items('Para_cada_fila')?['cuenta']",
                              "codigo_asignacion": "@items('Para_cada_fila')?['codigo']",
                              "importe": "@div(float(items('Para_cada_fila')?['centavos']),100.0)",
                              "moneda": "@items('Para_cada_fila')?['moneda']"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "runAfter": {
                        "TRY_FILA": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Etapa_confirmar": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Error_de_lote": {
                    "type": "If",
                    "expression": "@equals(outputs('Validar_lote'),'SIN_FILAS')",
                    "actions": {
                      "Sin_filas_codigo": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "varErrorCodigo",
                          "value": "SIN_FILAS"
                        },
                        "runAfter": {}
                      },
                      "Sin_filas_mensaje": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "varErrorMensaje",
                          "value": "No hay filas VALIDO para confirmar. No se confirmó ningún depósito."
                        },
                        "runAfter": {
                          "Sin_filas_codigo": [
                            "Succeeded"
                          ]
                        }
                      }
                    },
                    "else": {
                      "actions": {
                        "Lote_excede_codigo": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "varErrorCodigo",
                            "value": "LOTE_EXCEDE_LIMITE"
                          },
                          "runAfter": {}
                        },
                        "Lote_excede_mensaje": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "varErrorMensaje",
                            "value": "@concat('Se enviaron ',string(outputs('Total')),' filas y el máximo por confirmación es ',string(min(outputs('PARAM_MAX_FILAS_POR_LLAMADA'),outputs('PARAM_MAX_FILAS_ARCHIVO'))),'. No se confirmó ningún depósito: divida la confirmación en partes más pequeñas.')"
                          },
                          "runAfter": {
                            "Lote_excede_codigo": [
                              "Succeeded"
                            ]
                          }
                        }
                      }
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Validar_lote": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Entrada_invalida_codigo": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varErrorCodigo",
                  "value": "ENTRADA_INVALIDA"
                },
                "runAfter": {}
              },
              "Entrada_invalida_mensaje": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varErrorMensaje",
                  "value": "Faltan detalle_json o usuario_email, o detalle_json no es un arreglo JSON. No se confirmó ningún depósito."
                },
                "runAfter": {
                  "Entrada_invalida_codigo": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Validar_entrada": [
          "Succeeded"
        ]
      }
    },
    "CATCH": {
      "type": "Scope",
      "actions": {
        "Clasificar_fallo": {
          "type": "If",
          "expression": "@equals(variables('varEtapa'),'ENTRADA')",
          "actions": {
            "Fallo_entrada_codigo": {
              "type": "SetVariable",
              "inputs": {
                "name": "varErrorCodigo",
                "value": "ENTRADA_INVALIDA"
              },
              "runAfter": {}
            },
            "Fallo_entrada_mensaje": {
              "type": "SetVariable",
              "inputs": {
                "name": "varErrorMensaje",
                "value": "detalle_json no es un arreglo JSON válido. No se confirmó ningún depósito."
              },
              "runAfter": {
                "Fallo_entrada_codigo": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Fallo_global_codigo": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varErrorCodigo",
                  "value": "ERROR_NO_CONTROLADO"
                },
                "runAfter": {}
              },
              "Fallo_global_mensaje": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varErrorMensaje",
                  "value": "El proceso se interrumpió antes de terminar: algunos depósitos pueden haberse confirmado. Vuelva a PREVALIDAR para ver el estado real de cada uno antes de reintentar."
                },
                "runAfter": {
                  "Fallo_global_codigo": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "TRY": [
          "Failed",
          "TimedOut"
        ]
      }
    },
    "Confirmadas": {
      "type": "Query",
      "inputs": {
        "from": "@variables('varResultados')",
        "where": "@equals(item()?['resultado'],'CONFIRMADO')"
      },
      "runAfter": {
        "TRY": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "CATCH": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      }
    },
    "Cuenta_confirmadas": {
      "type": "Compose",
      "inputs": "@length(body('Confirmadas'))",
      "runAfter": {
        "Confirmadas": [
          "Succeeded"
        ]
      }
    },
    "Cuenta_recibidas": {
      "type": "Compose",
      "inputs": "@int(variables('varRecibidas'))",
      "runAfter": {
        "Cuenta_confirmadas": [
          "Succeeded"
        ]
      }
    },
    "Tiempos": {
      "type": "Compose",
      "inputs": "@concat('total=',string(div(sub(ticks(utcNow()),variables('varT0')),10000)),';filas=',variables('varRecibidas'),';ms_por_fila=',string(div(div(sub(ticks(utcNow()),variables('varT0')),10000),max(1,outputs('Cuenta_recibidas')))))",
      "runAfter": {
        "Cuenta_recibidas": [
          "Succeeded"
        ]
      }
    },
    "Responder_a_PowerApps": {
      "type": "Response",
      "kind": "PowerApp",
      "runAfter": {
        "Tiempos": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      },
      "inputs": {
        "statusCode": 200,
        "body": {
          "resultado": "@if(not(empty(variables('varErrorCodigo'))),'ERROR',if(equals(outputs('Cuenta_confirmadas'),outputs('Cuenta_recibidas')),'OK','PARCIAL'))",
          "codigo": "@if(not(empty(variables('varErrorCodigo'))),variables('varErrorCodigo'),if(equals(outputs('Cuenta_confirmadas'),outputs('Cuenta_recibidas')),'CONFIRMACION_OK',if(equals(outputs('Cuenta_confirmadas'),0),'NINGUNA_CONFIRMADA','CONFIRMACION_PARCIAL')))",
          "mensaje": "@if(not(empty(variables('varErrorCodigo'))),variables('varErrorMensaje'),concat(string(outputs('Cuenta_confirmadas')),' de ',string(outputs('Cuenta_recibidas')),' depósitos confirmados',if(equals(outputs('Cuenta_confirmadas'),outputs('Cuenta_recibidas')),'.',concat('; ',string(sub(outputs('Cuenta_recibidas'),outputs('Cuenta_confirmadas'))),' requieren revisión.'))))",
          "filas_recibidas": "@variables('varRecibidas')",
          "filas_confirmadas": "@string(outputs('Cuenta_confirmadas'))",
          "filas_no_confirmadas": "@string(sub(outputs('Cuenta_recibidas'),outputs('Cuenta_confirmadas')))",
          "detalle_json": "@string(variables('varResultados'))",
          "tiempos_ms": "@outputs('Tiempos')"
        },
        "schema": {
          "type": "object",
          "properties": {
            "resultado": {
              "title": "resultado",
              "type": "string",
              "x-ms-dynamically-added": true
            },
            "codigo": {
              "title": "codigo",
              "type": "string",
              "x-ms-dynamically-added": true
            },
            "mensaje": {
              "title": "mensaje",
              "type": "string",
              "x-ms-dynamically-added": true
            },
            "filas_recibidas": {
              "title": "filas_recibidas",
              "type": "string",
              "x-ms-dynamically-added": true
            },
            "filas_confirmadas": {
              "title": "filas_confirmadas",
              "type": "string",
              "x-ms-dynamically-added": true
            },
            "filas_no_confirmadas": {
              "title": "filas_no_confirmadas",
              "type": "string",
              "x-ms-dynamically-added": true
            },
            "detalle_json": {
              "title": "detalle_json",
              "type": "string",
              "x-ms-dynamically-added": true
            },
            "tiempos_ms": {
              "title": "tiempos_ms",
              "type": "string",
              "x-ms-dynamically-added": true
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
