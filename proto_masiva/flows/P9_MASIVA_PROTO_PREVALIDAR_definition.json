{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "PowerAppV2",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "file": {
              "title": "file",
              "type": "object",
              "x-ms-dynamically-added": true,
              "description": "Archivo XLSX seleccionado en la app",
              "x-ms-content-hint": "FILE",
              "properties": {
                "name": {
                  "type": "string"
                },
                "contentBytes": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "required": [
            "file"
          ]
        }
      }
    }
  },
  "actions": {
    "PARAM_SITIO": {
      "type": "Compose",
      "inputs": "https://univalleedu-my.sharepoint.com/personal/gtorricot_univalle_edu",
      "runAfter": {}
    },
    "PARAM_CARPETA": {
      "type": "Compose",
      "inputs": "/Documents/P9_MASIVA_TEMP",
      "runAfter": {
        "PARAM_SITIO": [
          "Succeeded"
        ]
      }
    },
    "PARAM_ENCABEZADOS": {
      "type": "Compose",
      "inputs": [
        "BANCO",
        "CUENTA_BANCARIA",
        "CODIGO_ASIGNACION",
        "IMPORTE",
        "MONEDA",
        "ESTUDIANTE",
        "SOLICITADO_POR",
        "SEDE",
        "OBSERVACION"
      ],
      "runAfter": {
        "PARAM_CARPETA": [
          "Succeeded"
        ]
      }
    },
    "PARAM_PAGINACION": {
      "type": "Compose",
      "inputs": 2000,
      "runAfter": {
        "PARAM_ENCABEZADOS": [
          "Succeeded"
        ]
      }
    },
    "PARAM_MAX_FILAS": {
      "type": "Compose",
      "inputs": 0,
      "runAfter": {
        "PARAM_PAGINACION": [
          "Succeeded"
        ]
      }
    },
    "Entrada": {
      "type": "Compose",
      "inputs": {
        "nombre": "@trim(coalesce(triggerBody()?['file']?['name'],''))",
        "base64": "@coalesce(triggerBody()?['file']?['contentBytes'],'')"
      },
      "runAfter": {
        "PARAM_MAX_FILAS": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varT0": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varT0",
            "type": "integer",
            "value": "@ticks(utcNow())"
          }
        ]
      },
      "runAfter": {
        "Entrada": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varT1": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varT1",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {
        "Inicializar_varT0": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varT2": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varT2",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {
        "Inicializar_varT1": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varT3": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varT3",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {
        "Inicializar_varT2": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varT4": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varT4",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {
        "Inicializar_varT3": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varEtapa": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varEtapa",
            "type": "string",
            "value": "ENTRADA"
          }
        ]
      },
      "runAfter": {
        "Inicializar_varT4": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varArchivoId": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varArchivoId",
            "type": "string",
            "value": ""
          }
        ]
      },
      "runAfter": {
        "Inicializar_varEtapa": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varBorrada": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varBorrada",
            "type": "string",
            "value": "NO_APLICA"
          }
        ]
      },
      "runAfter": {
        "Inicializar_varArchivoId": [
          "Succeeded"
        ]
      }
    },
    "Inicializar_varResultado": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "varResultado",
            "type": "object",
            "value": {
              "estado": "ERROR",
              "codigo": "ERROR_NO_CONTROLADO",
              "mensaje": "El archivo no se procesó. Vuelva a intentar.",
              "tabla": "",
              "filas": 0
            }
          }
        ]
      },
      "runAfter": {
        "Inicializar_varBorrada": [
          "Succeeded"
        ]
      }
    },
    "Validar_entrada": {
      "type": "Compose",
      "inputs": "@if(or(empty(outputs('Entrada')?['nombre']),empty(outputs('Entrada')?['base64'])),'SIN_ARCHIVO',if(not(endsWith(toLower(outputs('Entrada')?['nombre']),'.xlsx')),'NO_ES_XLSX',''))",
      "runAfter": {
        "Inicializar_varResultado": [
          "Succeeded"
        ]
      }
    },
    "TRY": {
      "type": "Scope",
      "actions": {
        "Entrada_valida": {
          "type": "If",
          "expression": "@empty(outputs('Validar_entrada'))",
          "actions": {
            "Etapa_copia": {
              "type": "SetVariable",
              "inputs": {
                "name": "varEtapa",
                "value": "COPIA"
              },
              "runAfter": {}
            },
            "Nombre_copia": {
              "type": "Compose",
              "inputs": "@concat('TMP_',guid(),'.xlsx')",
              "runAfter": {
                "Etapa_copia": [
                  "Succeeded"
                ]
              }
            },
            "Crear_archivo": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateFile"
                },
                "parameters": {
                  "dataset": "@outputs('PARAM_SITIO')",
                  "folderPath": "@outputs('PARAM_CARPETA')",
                  "name": "@outputs('Nombre_copia')",
                  "body": "@base64ToBinary(outputs('Entrada')?['base64'])"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {
                "Nombre_copia": [
                  "Succeeded"
                ]
              }
            },
            "Guardar_id_de_la_copia": {
              "type": "SetVariable",
              "inputs": {
                "name": "varArchivoId",
                "value": "@string(body('Crear_archivo')?['Id'])"
              },
              "runAfter": {
                "Crear_archivo": [
                  "Succeeded"
                ]
              }
            },
            "Marca_T1": {
              "type": "SetVariable",
              "inputs": {
                "name": "varT1",
                "value": "@ticks(utcNow())"
              },
              "runAfter": {
                "Guardar_id_de_la_copia": [
                  "Succeeded"
                ]
              }
            },
            "Etapa_excel": {
              "type": "SetVariable",
              "inputs": {
                "name": "varEtapa",
                "value": "EXCEL"
              },
              "runAfter": {
                "Marca_T1": [
                  "Succeeded"
                ]
              }
            },
            "Leer_tabla_Excel": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
                  "connectionName": "shared_excelonlinebusiness",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "source": "https://univalleedu-my.sharepoint.com/personal/gtorricot_univalle_edu",
                  "drive": "<CONFIGURAR_BIBLIOTECA_EXCEL>",
                  "file": "@body('Crear_archivo')?['Id']",
                  "table": "tblConfirmacionMasiva"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 2000
                }
              },
              "runAfter": {
                "Etapa_excel": [
                  "Succeeded"
                ]
              }
            },
            "Filas_brutas": {
              "type": "Compose",
              "inputs": "@coalesce(body('Leer_tabla_Excel')?['value'],createArray())",
              "runAfter": {
                "Leer_tabla_Excel": [
                  "Succeeded"
                ]
              }
            },
            "Hay_filas": {
              "type": "If",
              "expression": "@greater(length(outputs('Filas_brutas')),0)",
              "actions": {
                "Limite_de_lectura": {
                  "type": "If",
                  "expression": "@greaterOrEquals(length(outputs('Filas_brutas')),outputs('PARAM_PAGINACION'))",
                  "actions": {
                    "Resultado_DEMASIADAS_FILAS_LECTURA": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varResultado",
                        "value": {
                          "estado": "ERROR",
                          "codigo": "DEMASIADAS_FILAS",
                          "mensaje": "@concat('La lectura alcanzó el límite de ',string(outputs('PARAM_PAGINACION')),' filas: el recuento podría estar incompleto. Divida el archivo.')",
                          "tabla": "SI",
                          "filas": 0
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Encabezados_faltantes": {
                        "type": "Query",
                        "inputs": {
                          "from": "@outputs('PARAM_ENCABEZADOS')",
                          "where": "@not(contains(first(outputs('Filas_brutas')),item()))"
                        },
                        "runAfter": {}
                      },
                      "Estructura": {
                        "type": "If",
                        "expression": "@greater(length(body('Encabezados_faltantes')),0)",
                        "actions": {
                          "Resultado_ESTRUCTURA_INVALIDA": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "varResultado",
                              "value": {
                                "estado": "ERROR",
                                "codigo": "ESTRUCTURA_INVALIDA",
                                "mensaje": "@concat('Faltan o cambiaron encabezados: ',join(body('Encabezados_faltantes'),', '),'. Use la plantilla oficial.')",
                                "tabla": "SI",
                                "filas": 0
                              }
                            },
                            "runAfter": {}
                          }
                        },
                        "else": {
                          "actions": {
                            "Filas_con_datos": {
                              "type": "Query",
                              "inputs": {
                                "from": "@outputs('Filas_brutas')",
                                "where": "@not(and(empty(item()?['BANCO']),empty(item()?['CUENTA_BANCARIA']),empty(item()?['CODIGO_ASIGNACION']),empty(item()?['IMPORTE']),empty(item()?['MONEDA']),empty(item()?['ESTUDIANTE']),empty(item()?['SOLICITADO_POR']),empty(item()?['SEDE']),empty(item()?['OBSERVACION'])))"
                              },
                              "runAfter": {}
                            },
                            "Cantidad_con_datos": {
                              "type": "Compose",
                              "inputs": "@length(body('Filas_con_datos'))",
                              "runAfter": {
                                "Filas_con_datos": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "Hay_datos": {
                              "type": "If",
                              "expression": "@greater(outputs('Cantidad_con_datos'),0)",
                              "actions": {
                                "Hay_tope": {
                                  "type": "If",
                                  "expression": "@and(greater(outputs('PARAM_MAX_FILAS'),0),greater(outputs('Cantidad_con_datos'),outputs('PARAM_MAX_FILAS')))",
                                  "actions": {
                                    "Resultado_DEMASIADAS_FILAS_MAX": {
                                      "type": "SetVariable",
                                      "inputs": {
                                        "name": "varResultado",
                                        "value": {
                                          "estado": "ERROR",
                                          "codigo": "DEMASIADAS_FILAS",
                                          "mensaje": "@concat('El archivo tiene ',string(outputs('Cantidad_con_datos')),' filas y el máximo permitido es ',string(outputs('PARAM_MAX_FILAS')),'. Divida el archivo.')",
                                          "tabla": "SI",
                                          "filas": "@outputs('Cantidad_con_datos')"
                                        }
                                      },
                                      "runAfter": {}
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "Resultado_OK": {
                                        "type": "SetVariable",
                                        "inputs": {
                                          "name": "varResultado",
                                          "value": {
                                            "estado": "COMPLETADO",
                                            "codigo": "OK",
                                            "mensaje": "Archivo leído correctamente",
                                            "tabla": "SI",
                                            "filas": "@outputs('Cantidad_con_datos')"
                                          }
                                        },
                                        "runAfter": {}
                                      }
                                    }
                                  },
                                  "runAfter": {}
                                }
                              },
                              "else": {
                                "actions": {
                                  "Resultado_ARCHIVO_VACIO": {
                                    "type": "SetVariable",
                                    "inputs": {
                                      "name": "varResultado",
                                      "value": {
                                        "estado": "ERROR",
                                        "codigo": "ARCHIVO_VACIO",
                                        "mensaje": "La tabla no tiene filas con datos. Complete la plantilla y vuelva a intentar.",
                                        "tabla": "SI",
                                        "filas": 0
                                      }
                                    },
                                    "runAfter": {}
                                  }
                                }
                              },
                              "runAfter": {
                                "Cantidad_con_datos": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        },
                        "runAfter": {
                          "Encabezados_faltantes": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Resultado_TABLA_SIN_FILAS": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varResultado",
                      "value": {
                        "estado": "ERROR",
                        "codigo": "ARCHIVO_VACIO",
                        "mensaje": "La tabla no tiene filas. Complete la plantilla y vuelva a intentar.",
                        "tabla": "SI",
                        "filas": 0
                      }
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Filas_brutas": [
                  "Succeeded"
                ]
              }
            },
            "Marca_T2": {
              "type": "SetVariable",
              "inputs": {
                "name": "varT2",
                "value": "@ticks(utcNow())"
              },
              "runAfter": {
                "Hay_filas": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Entrada_invalida": {
                "type": "If",
                "expression": "@equals(outputs('Validar_entrada'),'SIN_ARCHIVO')",
                "actions": {
                  "Resultado_SIN_ARCHIVO": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varResultado",
                      "value": {
                        "estado": "ERROR",
                        "codigo": "SIN_ARCHIVO",
                        "mensaje": "No se recibió ningún archivo. Adjunte el Excel y vuelva a intentar.",
                        "tabla": "",
                        "filas": 0
                      }
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {
                    "Resultado_NO_ES_XLSX": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varResultado",
                        "value": {
                          "estado": "ERROR",
                          "codigo": "NO_ES_XLSX",
                          "mensaje": "El archivo no es .xlsx. Use la plantilla oficial.",
                          "tabla": "",
                          "filas": 0
                        }
                      },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Validar_entrada": [
          "Succeeded"
        ]
      }
    },
    "CATCH": {
      "type": "Scope",
      "actions": {
        "Clasificar_fallo": {
          "type": "If",
          "expression": "@equals(variables('varEtapa'),'EXCEL')",
          "actions": {
            "Fallo_en_excel": {
              "type": "If",
              "expression": "@equals(outputs('Leer_tabla_Excel')?['statusCode'],404)",
              "actions": {
                "Fallo_TABLA_NO_ENCONTRADA": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varResultado",
                    "value": {
                      "estado": "ERROR",
                      "codigo": "TABLA_NO_ENCONTRADA",
                      "mensaje": "No se encontró la tabla tblConfirmacionMasiva en el archivo. Use la plantilla oficial.",
                      "tabla": "NO",
                      "filas": 0
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Fallo_excel_no_404": {
                    "type": "If",
                    "expression": "@equals(outputs('Leer_tabla_Excel')?['statusCode'],423)",
                    "actions": {
                      "Fallo_ARCHIVO_BLOQUEADO": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "varResultado",
                          "value": {
                            "estado": "ERROR",
                            "codigo": "ARCHIVO_BLOQUEADO",
                            "mensaje": "El archivo está bloqueado. Ciérrelo e intente de nuevo.",
                            "tabla": "",
                            "filas": 0
                          }
                        },
                        "runAfter": {}
                      }
                    },
                    "else": {
                      "actions": {
                        "Fallo_ERROR_LECTURA_EXCEL": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "varResultado",
                            "value": {
                              "estado": "ERROR",
                              "codigo": "ERROR_LECTURA_EXCEL",
                              "mensaje": "@concat('No se pudo leer el Excel (HTTP ',string(outputs('Leer_tabla_Excel')?['statusCode']),'). ',take(coalesce(outputs('Leer_tabla_Excel')?['body']?['error']?['message'],''),200))",
                              "tabla": "",
                              "filas": 0
                            }
                          },
                          "runAfter": {}
                        }
                      }
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Fallo_no_excel": {
                "type": "If",
                "expression": "@equals(variables('varEtapa'),'COPIA')",
                "actions": {
                  "Fallo_ERROR_COPIA": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varResultado",
                      "value": {
                        "estado": "ERROR",
                        "codigo": "ERROR_COPIA_ARCHIVO",
                        "mensaje": "No se pudo crear la copia temporal del archivo.",
                        "tabla": "",
                        "filas": 0
                      }
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {
                    "Fallo_ERROR_NO_CONTROLADO": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varResultado",
                        "value": {
                          "estado": "ERROR",
                          "codigo": "ERROR_NO_CONTROLADO",
                          "mensaje": "Error inesperado al procesar el archivo. Vuelva a intentar o avise al administrador.",
                          "tabla": "",
                          "filas": 0
                        }
                      },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "TRY": [
          "Failed",
          "TimedOut"
        ]
      }
    },
    "LIMPIEZA": {
      "type": "Scope",
      "actions": {
        "Hay_copia_temporal": {
          "type": "If",
          "expression": "@not(empty(variables('varArchivoId')))",
          "actions": {
            "Borrar_copia_temporal": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "DeleteFile"
                },
                "parameters": {
                  "dataset": "@outputs('PARAM_SITIO')",
                  "id": "@variables('varArchivoId')"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "fixed",
                  "count": 2,
                  "interval": "PT5S"
                }
              },
              "runAfter": {}
            },
            "Marcar_borrada": {
              "type": "SetVariable",
              "inputs": {
                "name": "varBorrada",
                "value": "SI"
              },
              "runAfter": {
                "Borrar_copia_temporal": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "TRY": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "CATCH": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      }
    },
    "LIMPIEZA_FALLO": {
      "type": "Scope",
      "actions": {
        "Marcar_no_borrada": {
          "type": "SetVariable",
          "inputs": {
            "name": "varBorrada",
            "value": "NO"
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "LIMPIEZA": [
          "Failed",
          "TimedOut"
        ]
      }
    },
    "Marca_T3": {
      "type": "SetVariable",
      "inputs": {
        "name": "varT3",
        "value": "@ticks(utcNow())"
      },
      "runAfter": {
        "LIMPIEZA": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ],
        "LIMPIEZA_FALLO": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      }
    },
    "Marca_T4": {
      "type": "SetVariable",
      "inputs": {
        "name": "varT4",
        "value": "@ticks(utcNow())"
      },
      "runAfter": {
        "Marca_T3": [
          "Succeeded"
        ]
