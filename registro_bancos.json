{
  "_ayuda": {
    "proposito": "Registro parametrizable de bancos (P3). FORMATOS describe la estructura de un reporte; CUENTAS describe una instancia (banco, cuenta, moneda). Una cuenta nueva de un formato ya conocido se agrega con UNA entrada en CUENTAS y cero codigo.",
    "modo": "SOMBRA: lo lee motor_generico.py, que corre en paralelo al motor legado y solo reporta diferencias. La salida productiva sigue siendo la del motor legado.",
    "agregar_cuenta": "Copiar una entrada de CUENTAS, cambiar id (unico), cuenta (texto tal como aparece en la cabecera del extracto), banco y moneda, y dejar el mismo 'formato'. No tocar FORMATOS.",
    "campos_de_formato": {
      "familia": "Solo informativo (agrupa formatos del mismo banco).",
      "orden_deteccion": "Orden estable de evaluacion; no decide el resultado (si mas de un formato/cuenta coincide, el resultado es AMBIGUO).",
      "aceptado": "false = reporte real que existe pero NO es un extracto: se rechaza con 'mensaje'.",
      "hojas_aceptadas": "Nombres de hoja validos; se usa la primera que exista en el libro.",
      "firma": "Texto (normalizado: mayusculas, sin tildes) que debe aparecer en la cabecera y el encabezado, nunca en los datos. 'todas' = todos; 'alguna' = al menos uno.",
      "encabezados": "'puntaje' = encabezados esperados (define la fila de encabezado, igual que el legado); 'puntaje_minimo' = fraccion minima exigida.",
      "filtro_fecha": "Como se decide si una fila es un movimiento: PANDAS_DAYFIRST (pd.to_datetime dayfirst, igual que el legado) o NORMALIZAR_FECHA (acepta 24/Ago/2026).",
      "sin_columna_fecha": "ERROR (KeyError) o SIN_MOVIMIENTOS (extracto valido vacio, solo BISA hoy).",
      "campos": "Rol -> {alias, requerido}. 'alias' son los encabezados posibles del banco; 'constante' fija un valor cuando el banco no trae la columna.",
      "importe": "DEBITO_CREDITO (dos columnas) o SIGNO (una columna con signo).",
      "depositante": "VACIO | COLUMNA(campo) | legacy_bnb(campo): estrategia con nombre que conserva el resultado actual (D-18/D-19 sin tocar).",
      "info_adicional": "partes en orden; 'etiqueta' antepone 'ETIQUETA: '; sin etiqueta = valor crudo; se unen con 'separador'.",
      "filas_excluir": "Filas que no son movimientos (p. ej. SALDO INICIAL / SALDO AL CIERRE de BCP).",
      "saldo": "Fuentes de saldo inicial/final para la validacion (RECONSTRUIDO, ULTIMA_FILA, CELDA_FIJA, ETIQUETA, FILA_ROTULADA).",
      "campos_canonicos": "Encabezado original del banco -> etiqueta comun para consultar entre bancos (llena CAMPO_CANONICO)."
    }
  },
