        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "none"
        }
      },
      "runAfter": {
        "Crear_LOCK_si_falta": [
          "Succeeded"
        ]
      }
    },
    "Faltantes": {
      "type": "Query",
      "inputs": {
        "from": "@outputs('Campos_del_contrato')",
        "where": "@not(contains(string(body('Campos_finales')?['value']),concat('\"InternalName\":\"',item()?['nombre'],'\"')))"
      },
      "runAfter": {
        "Campos_finales": [
          "Succeeded"
        ]
      }
    },
    "Resultado": {
      "type": "Compose",
      "inputs": {
        "PROVISION_P10_CONTROL": "@if(equals(length(body('Faltantes')),0),'OK','FAIL')",
        "campos_faltantes": "@body('Faltantes')",
        "lista": "P10_Control"
      },
      "runAfter": {
        "Faltantes": [
          "Succeeded"
        ]
      }
    },
    "Finalizar": {
      "type": "If",
      "expression": "@equals(length(body('Faltantes')),0)",
      "actions": {
        "Terminar_OK": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {}
        }
      },
      "else": {
        "actions": {
          "Terminar_FAIL": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "PROVISION_P10_CONTROL_FAIL",
                "message": "Faltan columnas en P10_Control; ver el elemento Resultado."
              }
            },
            "runAfter": {}
          }
        }
      },
      "runAfter": {
        "Resultado": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
