          "nombre": "ESTADO_ASIGNACION",
          "cuerpo": "{\"__metadata\":{\"type\":\"SP.FieldChoice\"},\"Indexed\":true}"
        },
        {
          "nombre": "FECHA_MOVIMIENTO",
          "cuerpo": "{\"__metadata\":{\"type\":\"SP.FieldDateTime\"},\"Indexed\":true}"
        },
        {
          "nombre": "BANCO",
          "cuerpo": "{\"__metadata\":{\"type\":\"SP.FieldText\"},\"Indexed\":true}"
        },
        {
          "nombre": "LOTE_CARGA",
          "cuerpo": "{\"__metadata\":{\"type\":\"SP.FieldText\"},\"Indexed\":true}"
        },
        {
